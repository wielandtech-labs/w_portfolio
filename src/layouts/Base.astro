---
import '../styles/global.css';
// Same files the @fontsource CSS references, so the preload hits the cache.
import sansLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description: string;
  /** Absolute or root-relative path to a 1200x630 PNG. */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description, ogImage = '/og/default.png', ogType = 'website' } = Astro.props;
const fullTitle = title ? `${title} | WielandTech` : 'WielandTech: production systems, end to end';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
const path = Astro.url.pathname;

const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/services/', label: 'Services' },
  { href: '/contact/', label: 'Contact' },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="WielandTech" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:font-bold focus:text-accent-fg"
      >Skip to content</a
    >
    <header class="border-b-[3px] border-fg">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 px-4 sm:px-6">
        <a href="/" class="flex min-h-12 items-center gap-2 text-base font-black tracking-tight uppercase" aria-label="WielandTech home">
          <span class="size-3 bg-accent" aria-hidden="true"></span>
          WielandTech
        </a>
        <nav aria-label="Main">
          <ul class="flex items-stretch text-sm font-extrabold tracking-wide uppercase">
            {
              nav.map((item) => {
                const active = path.startsWith(item.href);
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        'inline-flex min-h-12 items-center border-b-[3px] px-2.5 -mb-[3px] sm:px-3',
                        active ? 'border-accent' : 'border-transparent text-muted hover:text-fg',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
            <li class="flex items-center">
              <button
                id="theme-toggle"
                type="button"
                class="invisible ml-1 inline-flex size-10 items-center justify-center border-2 border-fg hover:bg-fg hover:text-bg"
                aria-label="Toggle theme"
                aria-pressed="false"
              >
                <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true" fill="currentColor">
                  <path d="M12 2a10 10 0 1 0 0 20V2Z"></path>
                  <path d="M12 2a10 10 0 0 1 0 20" fill="none" stroke="currentColor" stroke-width="2"></path>
                </svg>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t-[3px] border-fg">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 sm:grid-cols-3 sm:px-6">
        <p class="text-sm">
          <span class="block font-black tracking-tight uppercase">WielandTech</span>
          <span class="text-muted">&copy; {year} VLAN Technology Services, LLC</span>
        </p>
        <ul class="space-y-1 text-sm font-semibold sm:col-span-2 sm:justify-self-end sm:text-right">
          <li><a class="hover:underline" href="mailto:raphael@wielandtech.com">raphael@wielandtech.com</a></li>
          <li><a class="hover:underline" href="https://raphaelwieland.com/">About me, resume and blog &rarr;</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
