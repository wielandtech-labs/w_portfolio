---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';

const email = 'raphael@wielandtech.com';
const subject = encodeURIComponent('Project inquiry');
---

<Base title="Contact" description="Get in touch with Raphael Wieland about a project.">
  <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
    <p class="label">Direct line · no sales team</p>
    <h1 class="display mt-3 text-6xl sm:text-8xl">Contact<span class="text-accent" aria-hidden="true">.</span></h1>
    <p class="mt-6 max-w-2xl text-lg leading-snug text-muted">
      Email is the quickest way to reach me. A few lines are enough to start: what you're building, where it runs today,
      and what's in the way.
    </p>

    <div class="mt-12 grid gap-[3px] border-[3px] border-fg bg-fg lg:grid-cols-3">
      <div class="bg-bg p-6 sm:p-8 lg:col-span-2">
        <h2 class="label">Email</h2>
        <p class="mt-2 text-2xl font-extrabold break-all sm:text-4xl">{email}</p>
      </div>
      <div class="flex flex-col justify-center gap-3 bg-bg p-6 sm:p-8">
        <CTA href={`mailto:${email}?subject=${subject}`}>Email me</CTA>
        <CTA href="https://raphaelwieland.com/contact/" variant="secondary">Contact form</CTA>
      </div>
    </div>

    <p class="mt-8 text-sm text-muted">
      Looking for my background and resume?
      <a class="font-bold text-fg underline decoration-accent decoration-2 underline-offset-2" href="https://raphaelwieland.com/">About me &rarr;</a>
    </p>
  </div>
</Base>
