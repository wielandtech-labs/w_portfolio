---
import Base from '../../layouts/Base.astro';
import WorkRow from '../../components/WorkRow.astro';
import { getWork } from '../../lib/work';

const work = await getWork();
---

<Base title="Work" description="Case studies: systems Raphael Wieland designed, built and runs in production.">
  <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
    <p class="label">{String(work.length).padStart(2, '0')} case studies · all running in production</p>
    <h1 class="display mt-3 text-6xl sm:text-8xl">Work<span class="text-accent" aria-hidden="true">.</span></h1>
    <p class="mt-6 max-w-2xl text-lg leading-snug text-muted">
      Each one is live and run by me. Each covers the problem, how it's built, what was hard, and what it does today.
    </p>
    <ol class="mt-12">
      {work.map((entry, i) => <WorkRow entry={entry} index={i} headingLevel="h2" />)}
    </ol>
  </div>
</Base>
