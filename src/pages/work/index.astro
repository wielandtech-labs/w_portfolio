---
import Base from '../../layouts/Base.astro';
import WorkRow from '../../components/WorkRow.astro';
import { getWork } from '../../lib/work';
import { breadcrumbs, graph } from '../../lib/schema';

const work = await getWork();

// Headline numbers from the resume on raphaelwieland.com; keep them in sync.
const earlier = [
  { value: '417x', label: 'more traffic after moving legacy customers onto cloud microservices' },
  { value: '96%', label: 'cut in SQL query times' },
  { value: '$6M', label: 'ARR no longer at risk after fixing config bugs in a legacy C++ codebase' },
];
const jsonLd = graph(
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work/' },
  ]),
  {
    '@type': 'ItemList',
    itemListElement: work.map((entry, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://wielandtech.com/work/${entry.data.slug}/`,
      name: entry.data.title,
    })),
  },
);
---

<Base title="Work" description="Case studies: systems Raphael Wieland designed, built and runs in production." jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6 sm:pt-16">
    <p class="label">{String(work.length).padStart(2, '0')} case studies · all running in production</p>
    <h1 class="display mt-3 text-6xl sm:text-8xl">Work<span class="text-accent" aria-hidden="true">.</span></h1>
    <p class="mt-6 max-w-2xl text-lg leading-snug text-muted">
      Each one is live and run by me. Each covers the problem, how it's built, what was hard, and what it does today.
    </p>
    <ol class="mt-12">
      {work.map((entry, i) => <WorkRow entry={entry} index={i} headingLevel="h2" />)}
    </ol>

    <section aria-labelledby="earlier-heading" class="mt-24">
      <header class="border-t-[3px] border-fg pt-3">
        <p class="label">Before this</p>
        <h2 id="earlier-heading" class="mt-2 text-2xl leading-tight font-extrabold">Employer work at Zonar Systems</h2>
      </header>
      <dl class="mt-6 grid gap-[3px] border-[3px] border-fg bg-fg sm:grid-cols-3">
        {
          earlier.map((e) => (
            <div class="flex flex-col-reverse justify-end gap-2 bg-bg p-5">
              <dt class="text-[0.95rem] leading-snug text-muted">{e.label}</dt>
              <dd class="display text-5xl tabular-nums">{e.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6">
        <a
          href="https://raphaelwieland.com/#resume"
          class="text-sm font-extrabold tracking-wide uppercase underline decoration-accent decoration-[3px] underline-offset-4"
        >
          Full resume &rarr;
        </a>
      </p>
    </section>
  </div>
</Base>
