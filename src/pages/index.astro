---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import CTA from '../components/CTA.astro';
import LiveStats from '../components/LiveStats.astro';
import { getWork } from '../lib/work';
import { services } from '../lib/services';

const featured = (await getWork()).filter((w) => w.data.featured);
---

<Base description="Raphael Wieland designs, builds and runs production systems: Kubernetes platforms, Django apps, data pipelines and LLM integrations.">
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24">
    <p class="mb-4 font-mono text-xs tracking-widest text-accent uppercase">Raphael Wieland · WielandTech</p>
    <h1 class="max-w-4xl text-4xl leading-[1.1] font-bold tracking-tight text-balance sm:text-6xl">
      I design, build and run production systems.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      Kubernetes platforms, Django and Python apps, data pipelines and AI integration, taken from the first
      commit to monitored production, then kept running.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <CTA href="/contact/">Work with me</CTA>
      <CTA href="/work/" variant="secondary">See the work</CTA>
    </div>
  </section>

  <Section id="work" eyebrow="Selected work" title="Shipped, live, and maintained">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((entry) => <Card entry={entry} />)}
    </div>
    <p class="mt-6"><a href="/work/" class="text-sm font-semibold text-accent hover:underline">All case studies &rarr;</a></p>
  </Section>

  <Section id="live" eyebrow="Proof it runs" title="The homelab, right now" class="mt-24">
    <p class="mb-6 max-w-2xl text-muted">
      Everything here is deployed to a Kubernetes cluster I built and operate. These numbers are live from it.{' '}
      <a href="/work/homelab/" class="text-accent underline underline-offset-2">How it's built &rarr;</a>
    </p>
    <LiveStats />
  </Section>

  <Section id="services" eyebrow="Services" title="What I can build for you" class="mt-24">
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        services.map((s) => (
          <li class="rounded-xl border border-border p-5">
            <h3 class="font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{s.summary}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6"><a href="/services/" class="text-sm font-semibold text-accent hover:underline">How engagements work &rarr;</a></p>
  </Section>

  <Section class="mt-24">
    <div class="rounded-2xl border border-border bg-surface px-6 py-10 sm:px-10">
      <h2 class="text-2xl font-bold tracking-tight">Have a system that needs building, or rescuing?</h2>
      <p class="mt-3 max-w-2xl text-muted">Tell me what you're working on and where it hurts.</p>
      <div class="mt-6"><CTA href="/contact/">Get in touch</CTA></div>
    </div>
  </Section>
</Base>
