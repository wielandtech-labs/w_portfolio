---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import WorkRow from '../components/WorkRow.astro';
import CTA from '../components/CTA.astro';
import LiveStats from '../components/LiveStats.astro';
import { getWork } from '../lib/work';
import { services } from '../lib/services';

const work = await getWork();
---

<Base description="Raphael Wieland designs, builds and runs production systems: Kubernetes platforms, Django apps, data pipelines and LLM integrations.">
  <LiveStats>
    <p class="label">Raphael Wieland · WielandTech</p>
    <h1 id="hero-heading" class="display mt-4 text-[2.5rem] text-balance sm:text-7xl">
      Production systems, end to end<span class="text-accent" aria-hidden="true">.</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-snug text-muted">
      I design, build and run Kubernetes platforms, Django apps, data pipelines and LLM integrations, from the first
      commit to on-call. Everything below is live.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <CTA href="/contact/">Work with me</CTA>
      <CTA href="/work/" variant="secondary">See the work</CTA>
    </div>
  </LiveStats>

  <Section id="work" index="01" eyebrow="Shipped and running" title="Work" class="mt-24">
    <ol>
      {work.map((entry, i) => <WorkRow entry={entry} index={i} />)}
    </ol>
  </Section>

  <Section id="services" index="02" eyebrow="What I can build for you" title="Services" class="mt-24">
    <ul class="grid gap-[3px] border-[3px] border-fg bg-fg sm:grid-cols-2">
      {
        services.map((s, i) => (
          <li class="bg-bg p-5 sm:p-6">
            <p class="label">
              <span class="text-fg">{String(i + 1).padStart(2, '0')}</span>
            </p>
            <h3 class="mt-2 text-xl leading-tight font-extrabold">{s.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-snug text-muted">{s.summary}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6">
      <a href="/services/" class="text-sm font-extrabold tracking-wide uppercase underline decoration-accent decoration-[3px] underline-offset-4">
        How engagements work &rarr;
      </a>
    </p>
  </Section>

  <Section class="mt-24">
    <div class="grid gap-6 bg-fg p-6 text-bg sm:p-10 lg:grid-cols-3 lg:items-end">
      <h2 class="display text-4xl sm:text-6xl lg:col-span-2">
        Need a system built, or rescued<span class="text-accent" aria-hidden="true">?</span>
      </h2>
      <div class="lg:justify-self-end">
        <p class="mb-4 text-bg/80">Tell me what you're building, and where it hurts.</p>
        <CTA href="/contact/">Get in touch</CTA>
      </div>
    </div>
  </Section>
</Base>
