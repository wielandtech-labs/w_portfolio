---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
---

<Base title="Not found" description="This page doesn't exist.">
  <div class="mx-auto max-w-3xl px-4 pt-24 sm:px-6">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">This page doesn't exist.</h1>
    <p class="mt-4 text-lg text-muted">It may have moved, or the link has a typo.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <CTA href="/work/">See the work</CTA>
      <CTA href="/" variant="secondary">Home</CTA>
    </div>
  </div>
</Base>
