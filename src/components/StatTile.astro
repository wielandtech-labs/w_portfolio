---
interface Props {
  stat: string;
  label: string;
}
const { stat, label } = Astro.props;
---

<div class="bg-bg p-4">
  <dt class="label">{label}</dt>
  <dd class="display mt-2 text-4xl tabular-nums" data-stat={stat}>&mdash;</dd>
  <dd class="mt-1 h-4 font-mono text-xs text-muted" data-stat-detail={stat}></dd>
</div>
