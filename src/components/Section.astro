---
interface Props {
  id?: string;
  title?: string;
  /** Section number shown before the eyebrow, e.g. '02'. */
  index?: string;
  eyebrow?: string;
  class?: string;
}
const { id, title, index, eyebrow, class: className } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
---

<section id={id} aria-labelledby={title ? headingId : undefined} class:list={['mx-auto max-w-6xl px-4 sm:px-6', className]}>
  {
    title && (
      <header class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-t-[3px] border-fg pt-3">
        <h2 id={headingId} class="display text-3xl sm:text-5xl">
          {title}
        </h2>
        {(index || eyebrow) && (
          <p class="label">
            {index && <span class="text-fg">{index} / </span>}
            {eyebrow}
          </p>
        )}
      </header>
    )
  }
  <slot />
</section>
