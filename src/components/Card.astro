---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  headingLevel?: 'h2' | 'h3';
}
const { entry, headingLevel = 'h3' } = Astro.props;
const { title, tagline, stack, cover, coverAlt, status, year } = entry.data;
const Heading = headingLevel;
const statusLabel = { live: 'Live', archived: 'Archived', wip: 'In progress' }[status];
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-border bg-surface transition-colors hover:border-accent">
  <Image
    src={cover}
    alt={coverAlt}
    class="aspect-[16/9] w-full object-cover"
  />
  <div class="flex flex-1 flex-col gap-3 p-5">
    <p class="font-mono text-xs text-muted">
      {year} · <span class={status === 'live' ? 'text-accent' : undefined}>{statusLabel}</span>
    </p>
    <Heading class="text-lg font-semibold tracking-tight">
      <a href={`/work/${entry.data.slug}/`} class="after:absolute after:inset-0">
        {title}
      </a>
    </Heading>
    <p class="text-sm leading-relaxed text-muted">{tagline}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-2" aria-label="Stack">
      {stack.slice(0, 4).map((s) => <Tag label={s} />)}
    </ul>
  </div>
</article>
