---
// Architecture diagram as themed HTML: a left-to-right pipeline on wide
// screens, top-to-bottom on phones. Text stays real text (searchable,
// screen-reader friendly), and it follows the light/dark tokens.
interface Step {
  label: string;
  detail?: string;
  highlight?: boolean;
}
interface Props {
  steps: Step[];
  caption: string;
  /** Optional side lane rendered under the pipeline, e.g. a feedback loop. */
  note?: string;
}
const { steps, caption, note } = Astro.props;
---

<figure class="my-10">
  <ol class="flex flex-col items-stretch gap-1 md:flex-row md:items-stretch">
    {
      steps.map((s, i) => (
        <li class="flex flex-col items-center gap-1 md:flex-1 md:flex-row">
          <div
            class:list={[
              'h-full w-full border-2 border-fg px-3 py-3',
              s.highlight ? 'bg-accent text-accent-fg' : 'bg-bg',
            ]}
          >
            <p class="font-mono text-[0.65rem] font-bold tracking-widest uppercase" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <p class="mt-1 text-sm leading-tight font-extrabold">{s.label}</p>
            {s.detail && (
              <p class:list={['mt-1 font-mono text-xs leading-snug', s.highlight ? 'text-accent-fg' : 'text-muted']}>{s.detail}</p>
            )}
          </div>
          {i < steps.length - 1 && (
            <span class="shrink-0 font-black" aria-hidden="true">
              <span class="md:hidden">↓</span>
              <span class="hidden md:inline">→</span>
            </span>
          )}
        </li>
      ))
    }
  </ol>
  {note && <p class="mt-2 border-2 border-dashed border-fg px-3 py-2 font-mono text-xs">↺ {note}</p>}
  <figcaption class="mt-3 font-mono text-xs text-muted">{caption}</figcaption>
</figure>
