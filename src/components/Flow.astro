---
// Architecture diagram as themed HTML: a left-to-right pipeline on wide
// screens, top-to-bottom on phones. Text stays real text (searchable,
// screen-reader friendly), and it follows the light/dark tokens.
interface Step {
  label: string;
  detail?: string;
  highlight?: boolean;
}
interface Props {
  steps: Step[];
  caption: string;
  /** Optional side lane rendered under the pipeline, e.g. a feedback loop. */
  note?: string;
}
const { steps, caption, note } = Astro.props;
---

<figure class="my-10">
  <ol class="flex flex-col items-stretch gap-2 md:flex-row md:items-stretch">
    {
      steps.map((s, i) => (
        <li class="flex flex-col items-center gap-2 md:flex-1 md:flex-row">
          <div
            class:list={[
              'w-full rounded-lg border px-3 py-3 text-center',
              s.highlight ? 'border-accent bg-accent-soft' : 'border-border bg-surface',
            ]}
          >
            <p class="text-sm font-semibold">{s.label}</p>
            {s.detail && <p class="mt-1 font-mono text-xs leading-snug text-muted">{s.detail}</p>}
          </div>
          {i < steps.length - 1 && (
            <span class="shrink-0 text-muted" aria-hidden="true">
              <span class="md:hidden">↓</span>
              <span class="hidden md:inline">→</span>
            </span>
          )}
        </li>
      ))
    }
  </ol>
  {note && <p class="mt-3 rounded-lg border border-dashed border-border px-3 py-2 font-mono text-xs text-muted">↺ {note}</p>}
  <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
</figure>
