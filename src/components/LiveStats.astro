---
import StatTile from './StatTile.astro';

// The home page hero: the headline (slot) beside 30-day availability, over a
// ruled grid of the other cluster numbers. The page leads with proof.
// Data: w_tech's /api/metrics/ (Prometheus); see AGENTS.md "Live stats".
const tiles = [
  { stat: 'deployments', label: 'Deployments healthy' },
  { stat: 'pods', label: 'Pods running' },
  { stat: 'nodes', label: 'Nodes ready' },
  { stat: 'traffic', label: 'Requests / sec' },
  { stat: 'database', label: 'Postgres data' },
];
---

<section data-live-stats aria-labelledby="hero-heading" class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 sm:pt-12">
  <div class="grid border-[3px] border-fg lg:grid-cols-3">
    <div class="p-5 sm:p-8 lg:col-span-2">
      <slot />
    </div>
    <dl data-slo-panel class="flex flex-col justify-between gap-6 border-t-[3px] border-fg bg-surface p-5 text-fg sm:p-8 lg:border-t-0 lg:border-l-[3px]">
      <div>
        <dt class="font-mono text-xs font-bold tracking-widest uppercase">Live from the homelab</dt>
        <dd class="mt-1 text-sm font-semibold">The cluster this site runs on, right now.</dd>
      </div>
      <div>
        <dt class="font-mono text-xs font-bold tracking-widest uppercase">Availability · 30 days</dt>
        <dd class="display mt-1 text-6xl tabular-nums sm:text-7xl" data-stat="availability">&mdash;</dd>
        <dd class="mt-1 h-10 text-sm font-semibold whitespace-pre-line" data-stat-detail="availability"></dd>
      </div>
    </dl>
  </div>
  <dl class="grid grid-cols-2 gap-[3px] border-x-[3px] border-b-[3px] border-fg bg-fg lg:grid-cols-5 [&>*:last-child]:col-span-2 lg:[&>*:last-child]:col-span-1">
    {tiles.map((t) => <StatTile {...t} />)}
  </dl>
  <p class="mt-3 flex flex-wrap items-center gap-x-2 font-mono text-xs text-muted">
    <span class="inline-block size-2 bg-border" data-stats-dot aria-hidden="true"></span>
    <span data-stats-status role="status" aria-live="polite">Loading live stats…</span>
    <span data-stats-updated></span>
    <a href="/work/homelab/" class="ml-auto font-bold text-fg underline decoration-accent decoration-2 underline-offset-2">How it's built &rarr;</a>
  </p>
</section>

<script>
  // Polls the homelab metrics (same-origin; nginx proxies to w_tech) and
  // fills the StatTiles. Failure leaves the layout intact with a message.
  type Metrics = {
    availability?: {
      percentage: number;
      services: number;
      slo_met: number | null;
      state: 'healthy' | 'at_risk' | 'breached';
    } | null;
    deployments?: { total: number; healthy: number } | null;
    pods?: { count: number } | null;
    nodes?: { count: number; ready?: number | null } | null;
    traffic?: { requests_per_second: number } | null;
    database?: { size_mb: number; databases: number } | null;
  };

  const POLL_MS = 30_000;
  const TIMEOUT_MS = 6_000;

  const root = document.querySelector<HTMLElement>('[data-live-stats]');
  if (root) {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const status = root.querySelector<HTMLElement>('[data-stats-status]')!;
    const dot = root.querySelector<HTMLElement>('[data-stats-dot]')!;
    const updated = root.querySelector<HTMLElement>('[data-stats-updated]')!;
    const sloPanel = root.querySelector<HTMLElement>('[data-slo-panel]')!;
    const tiles = [...root.querySelectorAll<HTMLElement>('[data-stat]')].map((el) => el.dataset.stat!);
    const value = (k: string) => root.querySelector<HTMLElement>(`[data-stat="${k}"]`);
    const detail = (k: string) => root.querySelector<HTMLElement>(`[data-stat-detail="${k}"]`);
    let first = true;
    let timer: number | undefined;

    const setText = (k: string, text: string, sub = '') => {
      const v = value(k);
      const d = detail(k);
      if (v) v.textContent = text;
      if (d) d.textContent = sub;
    };

    // Count up from 0 on the first successful load only, and never when the
    // visitor asked for reduced motion.
    const setNumber = (k: string, n: number, fmt: (x: number) => string, sub = '') => {
      const v = value(k);
      if (!v) return;
      if (!first || reduceMotion) return setText(k, fmt(n), sub);
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / 700);
        v.textContent = fmt(n * (1 - Math.pow(1 - t, 3)));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      // rAF doesn't run in background tabs; never leave the final value to it.
      setTimeout(() => (v.textContent = fmt(n)), 800);
      const d = detail(k);
      if (d) d.textContent = sub;
    };

    const int = (x: number) => Math.round(x).toString();
    const oneDp = (x: number) => x.toFixed(1);
    // w_tech floors to 2 decimals, so an imperfect month never reads as 100.00%.
    const availability = (x: number) => `${x.toFixed(2)}%`;
    const size = (mb: number) => (mb >= 1000 ? `${(mb / 1000).toFixed(1)} GB` : `${Math.round(mb)} MB`);

    // The availability panel takes its color from the SLO tier met (99.9% /
    // 99% / below), and stays neutral when there's no data.
    const panelFill = { healthy: 'bg-ok', at_risk: 'bg-warn', breached: 'bg-bad' } as const;
    const setPanel = (state?: keyof typeof panelFill) => {
      sloPanel.classList.remove('bg-surface', 'text-fg', 'text-accent-fg', ...Object.values(panelFill));
      sloPanel.classList.add(...(state ? [panelFill[state], 'text-accent-fg'] : ['bg-surface', 'text-fg']));
    };

    const render = (m: Metrics) => {
      // A card is null when its query failed; never leave its old number up.
      tiles.forEach((t) => setText(t, '—'));
      // A count-up from 0% would flash "failing" numbers, so this one is static.
      const a = m.availability;
      setPanel(a?.state);
      if (a) {
        const slo = a.slo_met === null ? 'Below the 99% SLO' : `Meets the ${a.slo_met}% SLO`;
        setText('availability', availability(a.percentage), `${slo}
across ${a.services} monitored services`);
      }
      if (m.deployments)
        setNumber('deployments', m.deployments.healthy, int, `of ${m.deployments.total}`);
      if (m.pods) setNumber('pods', m.pods.count, int);
      if (m.nodes && typeof m.nodes.ready === 'number')
        setNumber('nodes', m.nodes.ready, int, `of ${m.nodes.count}`);
      if (m.traffic) setNumber('traffic', m.traffic.requests_per_second, oneDp, 'ingress, 5 min avg');
      if (m.database) setText('database', size(m.database.size_mb), `${m.database.databases} databases`);
      first = false;
    };

    const setStatus = (ok: boolean) => {
      dot.classList.toggle('bg-accent', ok);
      dot.classList.toggle('bg-border', !ok);
      // Only the state goes in the live region, so screen readers hear a
      // change (live <-> unavailable), not a new timestamp every poll.
      const text = ok ? 'Live from the homelab' : 'Live stats unavailable right now.';
      if (status.textContent !== text) status.textContent = text;
      updated.textContent = ok
        ? `· updated ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`
        : '';
      // Never leave old numbers on screen looking live.
      if (!ok) {
        tiles.forEach((t) => setText(t, '—'));
        setPanel();
      }
    };

    const load = async () => {
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), TIMEOUT_MS);
      try {
        const res = await fetch('/api/metrics/', { signal: ctrl.signal, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        render((await res.json()) as Metrics);
        setStatus(true);
      } catch {
        setStatus(false);
      } finally {
        clearTimeout(t);
      }
    };

    const start = () => {
      if (timer !== undefined) return;
      void load();
      timer = window.setInterval(load, POLL_MS);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    if (!document.hidden) start();
  }
</script>
